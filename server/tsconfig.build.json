{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "outDir": "../dist-server",
    "rootDir": "..",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["**/*.ts", "../src/game/**/*.ts", "../src/net/protocol.ts"]
}
