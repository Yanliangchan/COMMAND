{
  "name": "command-saf-strategy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n client,server -c cyan,yellow \"npm:dev\" \"npm:server\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prestart": "npm run build",
    "start": "tsx server/index.ts",
    "mapcheck": "tsx scripts/mapcheck.ts",
    "wirecheck": "tsx scripts/wirecheck.ts",
    "combatcheck": "tsx scripts/combatcheck.ts",
    "check": "npm run mapcheck && npm run wirecheck && npm run combatcheck && npm run islandcheck && npm run iocheck",
    "islandcheck": "tsx scripts/islandcheck.ts",
    "iocheck": "tsx scripts/iocheck.mts"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.13",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
