{
  "name": "command-saf-strategy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n client,server -c cyan,yellow \"npm:dev\" \"npm:server\"",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "node -e \"require('fs').rmSync('dist-server',{recursive:true,force:true})\" && tsc -p server/tsconfig.build.json && node -e \"require('fs').copyFileSync('server/dist-server-package.json','dist-server/package.json')\"",
    "preview": "vite preview",
    "prestart": "npm run build",
    "start": "node dist-server/server/index.js",
    "mapcheck": "tsx scripts/mapcheck.ts",
    "wirecheck": "tsx scripts/wirecheck.ts",
    "combatcheck": "tsx scripts/combatcheck.ts",
    "check": "npm run mapcheck && npm run wirecheck && npm run combatcheck && npm run islandcheck",
    "islandcheck": "tsx scripts/islandcheck.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "d3-delaunay": "^6.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
