# WebSocket URL the client connects to for multiplayer. Copy this file to
# .env.local and adjust if the server runs on a different host/port.
VITE_WS_URL=ws://localhost:8787

# Island Ops online endpoint (defaults to ws://localhost:8787/io in dev,
# same-origin /io in production).
# VITE_IO_URL=ws://localhost:8787/io
